{
  "expo": {
    "name": "Puppysteps",
    "slug": "puppysteps",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "puppysteps",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.eaconsulting.puppysteps",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Puppysteps uses reminders to help you take your puppy out at the right time."
      }
    },
    "android": {
      "package": "com.puppysteps.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4ED"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2F6B5F"
        }
      ],
      "expo-localization",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
